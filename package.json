{
  "name": "finpal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Privacy-first Brutto-Netto- und Teilzeit-Rechner für Deutschland. Rechnet vollständig lokal im Browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
